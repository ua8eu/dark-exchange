# Public origin used for verification emails and CSRF validation.
# Local: http://localhost:3000. Production: https://dark-exchange.com
# Vercel Preview: leave unset to derive the exact trusted VERCEL_URL *.vercel.app origin.
# Use a separate Neon preview branch. Request Host headers are never trusted.
APP_URL=http://localhost:3000

# Required on Vercel/production: pooled Neon PostgreSQL URL with verified TLS.
# Example: postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full
DATABASE_URL=

# Set strong unique credentials before first run. Never commit .env.local.
ADMIN_EMAIL=admin@dark-exchange.com
ADMIN_PASSWORD=

# First accepted demo withdrawal threshold in TEST USDT; admin settings override it.
FIRST_WITHDRAWAL_MINIMUM=1000
# Development/tests only when DATABASE_URL is absent. Never used in production.
# Optional absolute SQLite path. Default: ./.data/exchange.sqlite
DATABASE_PATH=

# Enables a local demo-user button ONLY in development. Always ignored in production.
ALLOW_DEMO_ACCESS=false

# Configure SMTP to deliver actual verification emails.
# Without SMTP, development returns an explicitly labeled local verification preview.
# Production never returns verification links and requires SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="dark-exchange.com <no-reply@dark-exchange.com>"
